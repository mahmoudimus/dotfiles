# Secrets for interactive shells. Nothing here is a literal secret.
#
# Rule: never call 1Password's `op read` at shell start. op is signed out by
# default and would block every new terminal on a sign-in prompt. Anything that
# needs op goes behind a function you run on demand.
{{- if eq .chezmoi.os "darwin" }}

# Keychain needs no sign-in and costs ~20ms per lookup. Each variable is only
# exported when the item exists, so a missing item neither prints an error
# (which would also trip p10k's instant prompt) nor exports an empty value.
_keychain_export() {
    local _value
    _value=$(security find-generic-password -s "$1" -w 2>/dev/null)
    [ -n "$_value" ] && export "$1=$_value"
}
_keychain_export HOMEBREW_GITHUB_API_TOKEN

# GITHUB_TOKEN must never hold an unresolved `op://` reference. gh reads
# GITHUB_TOKEN in preference to its own keyring credentials, so a bad value
# shadows working auth: `gh auth status` reports "The token in GITHUB_TOKEN is
# invalid". If the Keychain item is missing, GITHUB_TOKEN stays unset and gh
# falls back to its keyring, which is the working path.
_keychain_export GITHUB_TOKEN
unfunction _keychain_export

# One-time per machine, after `op signin`: copy the token out of 1Password into
# Keychain so the block above finds it. New shells pick it up from then on.
#
# `security` takes the secret as an argument, so it is briefly visible to `ps`
# on this machine. If you would rather not, run this instead and paste at the
# prompt, which reads from the terminal without echoing:
#
#     security add-generic-password -U -a "$USER" -s GITHUB_TOKEN -w
#
sync_github_token_to_keychain() {
    if ! command -v op > /dev/null 2>&1; then
        echo "sync_github_token_to_keychain: 1Password CLI (op) not found" >&2
        return 1
    fi

    local _token
    if ! _token=$(op read "op://Private/gz6cwnpibov6b2nbrsbx2lhso4/token"); then
        echo "sync_github_token_to_keychain: op read failed; run 'op signin' first" >&2
        return 1
    fi

    if [ -z "$_token" ]; then
        echo "sync_github_token_to_keychain: op returned an empty value" >&2
        return 1
    fi

    security add-generic-password -U -a "$USER" -s GITHUB_TOKEN -w "$_token" || return 1
    _token=

    echo "GITHUB_TOKEN stored in Keychain. Open a new shell to pick it up."
}
{{- end }}

# On demand: export API keys for LLM tools from 1Password.
export_llm_keys() {
    if ! command -v op > /dev/null 2>&1; then
        echo "export_llm_keys: 1Password CLI (op) not found" >&2
        return 1
    fi
    export KIMI_API_KEY=$(op read "op://Private/KIMI_API_KEY/credential")
    export NVIDIA_NIM_API_KEY=$(op read "op://Private/NVIDIA_NIM_API_KEY/credential")
}
